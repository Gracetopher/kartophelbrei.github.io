<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Derby Pack-List</title>
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Derby Pack">
<meta name="theme-color" content="#7c3aed">
<link rel="apple-touch-icon" href="icons/star-skate.png">
<link rel="icon" href="icons/star-skate.png">
<link rel="manifest" href="manifest.json">
<style>
  :root{
    --bg:#f7f5fb; --card:#ffffff; --text:#1c1726; --sub:#6b6478;
    --accent:#7c3aed; --accent-ink:#ffffff; --border:#e4e0ee; --danger:#c0392b;
    box-sizing:border-box;
    padding-top:env(safe-area-inset-top,0px);
    padding-bottom:env(safe-area-inset-bottom,0px);
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --bg:#17131f; --card:#231d2e; --text:#f1eef7; --sub:#a79fba;
      --accent:#a78bfa; --accent-ink:#17131f; --border:#342c44;
    }
  }
  :root[data-theme="dark"]{
    --bg:#17131f; --card:#231d2e; --text:#f1eef7; --sub:#a79fba;
    --accent:#a78bfa; --accent-ink:#17131f; --border:#342c44;
  }
  *{box-sizing:border-box}
  html{scroll-padding-top:env(safe-area-inset-top,0px)}
  body{
    margin:0; background:var(--bg); color:var(--text);
    font:15px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
    min-height:100%;
  }
  header{
    position:sticky; top:0; z-index:5;
    padding:calc(14px + env(safe-area-inset-top,0px)) 16px 14px;
    background:var(--accent); color:var(--accent-ink);
  }
  header h1{margin:0; font-size:19px}
  header p{margin:2px 0 0; font-size:12.5px; opacity:.85}
  main{max-width:560px; margin:0 auto; padding:14px 14px 48px}
  .card{background:var(--card); border:1px solid var(--border); border-radius:14px; padding:14px; margin-bottom:12px}
  .card h2{margin:0 0 10px; font-size:14.5px; text-transform:uppercase; letter-spacing:.03em; color:var(--sub)}
  label{display:block; font-size:13.5px; margin:10px 0 4px}
  label.row{display:flex; align-items:center; gap:8px; margin:8px 0}
  label.row input[type=checkbox]{width:18px; height:18px; flex:none}
  input[type=text],input[type=number],input[type=date],select,textarea{
    width:100%; padding:9px 10px; border-radius:9px; border:1px solid var(--border);
    background:var(--bg); color:var(--text); font-size:15px;
  }
  textarea{font-family:ui-monospace,Menlo,monospace; font-size:12.5px; min-height:110px}
  .hint{font-size:12px; color:var(--sub); margin-top:3px}
  button{
    font-size:14.5px; padding:9px 14px; border-radius:10px; border:1px solid var(--border);
    background:var(--bg); color:var(--text); cursor:pointer;
  }
  button.primary{background:var(--accent); color:var(--accent-ink); border-color:transparent; font-weight:600}
  button.small{padding:6px 10px; font-size:13px}
  .wheelgrid{display:grid; gap:6px; margin-top:8px}
  .wheelgrid label{
    display:flex; align-items:center; gap:8px; margin:0; padding:8px 10px;
    border:1px solid var(--border); border-radius:9px; font-size:13.5px;
  }
  .wheelgrid span.fit{margin-left:auto; color:var(--sub); font-size:12px}
  details summary{cursor:pointer; font-size:13px; color:var(--sub); margin-top:4px}
  #savedVenues{display:flex; flex-wrap:wrap; gap:6px; margin-top:8px}
  .chip{padding:5px 10px; border-radius:999px; border:1px solid var(--border); font-size:12.5px; cursor:pointer}
  .chip.active{background:var(--accent); color:var(--accent-ink); border-color:transparent}
  #output h3{font-size:13px; text-transform:uppercase; letter-spacing:.03em; color:var(--sub); margin:14px 0 6px}
  #output h3:first-child{margin-top:0}
  #output label.row{padding:6px 0; border-bottom:1px solid var(--border)}
  #output label.row:last-child{border-bottom:none}
  #listTitle{font-weight:700; margin-bottom:4px}
  .err{color:var(--danger); font-size:12.5px; margin-top:4px}
  @media print {
    header, .card:not(#output), #pdfBtn { display: none !important; }
    #output { display: block !important; border: none; padding: 0; }
    body { background: #fff; color: #000; }
  }
</style>
</head>
<body>
   <h1>Packlists</h1>
   <div id="packlists">
    So far just the one - <a href="/packlist/derby/">Derby Packlist</a> for gameday.
   </div>